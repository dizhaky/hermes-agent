{
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "${HOME}/.local/bin/codebase-memory-mcp",
      "args": []
    },
    "tolaria": {
      "type": "stdio",
      "command": "${HOME}/.local/bin/tolaria-mcp-bridge",
      "args": [],
      "env": {
        "TOLARIA_MCP_URL": "ws://127.0.0.1:9710"
      }
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@0.6.2"
      ]
    }
  }
}
