# /etc/hermes/gateway.env — environment file for hermes-gateway.service.
#
# This file should contain EXACTLY ONE secret: the 1Password service account
# token that lets the gateway fetch everything else (SLACK_BOT_TOKEN,
# SLACK_APP_TOKEN, provider API keys, ...) from 1Password at startup.
#
#   install -d -m 750 /etc/hermes
#   install -m 600 gateway.env.example /etc/hermes/gateway.env
#   chown root:root /etc/hermes/gateway.env
#
# Never commit the real token anywhere.  Rotate it from the 1Password
# admin console (Developer -> Service Accounts) if it ever leaks.
OP_SERVICE_ACCOUNT_TOKEN=ops_...your-service-account-token...
