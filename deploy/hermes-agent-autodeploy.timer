# hermes-agent-autodeploy.timer — fire the autodeploy oneshot on a cadence.
# Install alongside hermes-agent-autodeploy.service (same directory / scope).

[Unit]
Description=Schedule Hermes Agent auto-deploy checks
Documentation=https://hermes-agent.nousresearch.com/docs/guides/persistent-hosting

[Timer]
# First check shortly after boot, then every 15 minutes. The oneshot exits
# silently when the checkout is already current, so a frequent cadence is
# cheap — the only visible action is on an actual new commit.
OnBootSec=5min
OnUnitActiveSec=15min
# Catch up on a single missed run if the machine was asleep/off at fire time.
Persistent=true
# Spread fires off the exact minute boundary so many hosts don't hammer the
# git remote in lockstep.
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
